// Hostel Dudes PG Finder - Complete Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  PG_OWNER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  ANY
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  DORMITORY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

enum InquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING
  INQUIRY
  REVIEW
  SYSTEM
  PAYMENT
  APPROVAL
}

enum PGStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  SUSPENDED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?
  role          UserRole      @default(STUDENT)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  // Relations
  ownerProfile  OwnerAccount?
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  inquiries     Inquiry[]
  notifications Notification[]
  payments      Payment[]
  sentMessages  ChatMessage[]   @relation("SentMessages")
  visits        VisitSchedule[]

  @@index([email])
  @@index([role])
}

// ─── NextAuth Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.LongText
  access_token      String? @db.LongText
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.LongText
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Owner Account ────────────────────────────────────────────────────────────

model OwnerAccount {
  id           String        @id @default(cuid())
  userId       String        @unique
  adminId      String        @unique // Generated by Super Admin
  businessName String?
  gstin        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  idProof      String?       // URL to uploaded ID
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pgs  PG[]

  @@index([adminId])
}

// ─── City ─────────────────────────────────────────────────────────────────────

model City {
  id          String   @id @default(cuid())
  name        String   @unique
  state       String
  slug        String   @unique
  image       String?
  description String?
  pgCount     Int      @default(0)
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())

  colleges College[]
  pgs      PG[]

  @@index([slug])
}

// ─── College ──────────────────────────────────────────────────────────────────

model College {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cityId    String
  address   String?
  latitude  Float?
  longitude Float?
  image     String?
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id])
  pgs  PGCollege[]

  @@index([cityId])
  @@index([slug])
}

// ─── PG ───────────────────────────────────────────────────────────────────────

model PG {
  id             String    @id @default(cuid())
  ownerId        String
  cityId         String
  name           String
  slug           String    @unique
  description    String    @db.LongText
  address        String
  area           String
  latitude       Float
  longitude      Float
  gender         Gender    @default(ANY)
  status         PGStatus  @default(PENDING)
  featured       Boolean   @default(false)
  verified       Boolean   @default(false)
  images         Json      // Array of image URLs (stored as JSON)
  coverImage     String?
  minRent        Int
  maxRent        Int
  deposit        Int?
  noticePeriod   Int?      // Days
  curfewTime     String?
  totalRooms     Int       @default(0)
  availableRooms Int       @default(0)
  rating         Float     @default(0)
  reviewCount    Int       @default(0)
  viewCount      Int       @default(0)
  phone          String?
  whatsapp       String?
  website        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Amenities flags
  hasWifi        Boolean @default(false)
  hasAC          Boolean @default(false)
  hasFood        Boolean @default(false)
  hasParking     Boolean @default(false)
  hasLaundry     Boolean @default(false)
  hasSecurity    Boolean @default(false)
  hasPowerBackup Boolean @default(false)
  hasCCTV        Boolean @default(false)
  hasGym         Boolean @default(false)
  hasAttachedBath Boolean @default(false)
  hasHotWater    Boolean @default(false)
  hasTVRoom      Boolean @default(false)

  owner     OwnerAccount  @relation(fields: [ownerId], references: [id])
  city      City          @relation(fields: [cityId], references: [id])
  rooms     Room[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
  inquiries Inquiry[]
  colleges  PGCollege[]
  foodMenu  FoodMenu[]
  payments  Payment[]
  chats     Chat[]
  visits    VisitSchedule[]

  @@index([ownerId])
  @@index([cityId])
  @@index([slug])
  @@index([status])
  @@index([gender])
  @@index([rating])
}

// ─── PG College Junction ──────────────────────────────────────────────────────

model PGCollege {
  pgId       String
  collegeId  String
  distance   Float  // km
  travelTime Int?   // minutes

  pg      PG      @relation(fields: [pgId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id])

  @@id([pgId, collegeId])
}

// ─── Room ─────────────────────────────────────────────────────────────────────

model Room {
  id          String   @id @default(cuid())
  pgId        String
  type        RoomType @default(SINGLE)
  rent        Int
  deposit     Int?
  totalBeds   Int      @default(1)
  availBeds   Int      @default(1)
  floor       Int?
  images      Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pg       PG        @relation(fields: [pgId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([pgId])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  userId       String
  pgId         String
  roomId       String?
  status       BookingStatus @default(PENDING)
  checkInDate  DateTime
  checkOutDate DateTime?
  rent         Int
  deposit      Int?
  totalAmount  Int
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  pg       PG       @relation(fields: [pgId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([pgId])
  @@index([status])
}

// ─── Review ───────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  userId     String
  pgId       String
  rating     Int      // 1-5
  comment    String   @db.LongText
  images     Json
  isVerified Boolean  @default(false)
  helpful    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  pg   PG   @relation(fields: [pgId], references: [id])

  @@unique([userId, pgId])
  @@index([pgId])
  @@index([rating])
}

// ─── Favorite ─────────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  pgId      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  pg   PG   @relation(fields: [pgId], references: [id])

  @@unique([userId, pgId])
}

// ─── Inquiry ──────────────────────────────────────────────────────────────────

model Inquiry {
  id        String        @id @default(cuid())
  userId    String
  pgId      String
  message   String        @db.LongText
  status    InquiryStatus @default(OPEN)
  response  String?       @db.LongText
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
  pg   PG   @relation(fields: [pgId], references: [id])

  @@index([userId])
  @@index([pgId])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  userId            String
  pgId              String
  bookingId         String?
  amount            Int           // in paise
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  pg      PG       @relation(fields: [pgId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([pgId])
  @@index([status])
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model Chat {
  id        String   @id @default(cuid())
  pgId      String
  studentId String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pg       PG          @relation(fields: [pgId], references: [id])
  messages ChatMessage[]

  @@unique([pgId, studentId])
  @@index([studentId])
  @@index([ownerId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String   @db.LongText
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("SentMessages", fields: [senderId], references: [id])

  @@index([chatId])
}

// ─── Food Menu ────────────────────────────────────────────────────────────────

model FoodMenu {
  id        String   @id @default(cuid())
  pgId      String
  day       String   // Monday, Tuesday...
  breakfast String?
  lunch     String?
  dinner    String?
  snacks    String?
  createdAt DateTime @default(now())

  pg PG @relation(fields: [pgId], references: [id], onDelete: Cascade)

  @@unique([pgId, day])
}

// ─── Visit Schedule ───────────────────────────────────────────────────────────

model VisitSchedule {
  id          String        @id @default(cuid())
  userId      String
  pgId        String
  scheduledAt DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])
  pg   PG   @relation(fields: [pgId], references: [id])

  @@index([userId])
  @@index([pgId])
}
